---
import { findClash } from "../lib/clashes";
import { GROUPS_LAST_CHECKED, listExceptions, listGroups } from "../lib/db";
import "../styles.css";

const groups = listGroups();
const exceptionRows = listExceptions();
const groupBySlug = new Map(groups.map((group) => [group.slug, group]));

// A group's own history is otherwise buried in a board showing every group's
// proposals mixed together. Clash detection still needs the *full* list
// (exceptionRows) regardless of this filter — a clash can depend on another
// group's row this view is hiding.
const filterSlug = Astro.url.searchParams.get("group") ?? "";
const visibleExceptions = filterSlug
  ? exceptionRows.filter((exception) => exception.groupSlug === filterSlug)
  : exceptionRows;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Crit slot exceptions — COMP4020 prototype</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Exceptions</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Crit slot exceptions</h1>
      <p>
        Six crit groups each hold a standing weekly slot, published on the
        course website. When a public holiday, room clash or tutor swap needs
        a one-off replacement, that change currently lands as a hand-edited
        entry in the website's own data file. This board is the slice before
        that: anyone can propose a replacement slot for a given week, see
        every open proposal in one place, and confirm one once it's settled —
        all of it live across open tabs, and still there on reload.
      </p>

      <section aria-labelledby="groups-heading">
        <h2 id="groups-heading">Standing slots</h2>
        <p class="cache-note">
          Cached from the course website's published API, last checked{" "}
          {GROUPS_LAST_CHECKED}. It doesn't refresh itself — if the website
          changes a slot mid-week, this table won't notice until the app is
          redeployed with a fresh seed. The exceptions below are this app's
          own live state, not a cache.
        </p>
        <table>
          <thead>
            <tr>
              <th scope="col">Group</th>
              <th scope="col">Slot</th>
              <th scope="col">Tutor</th>
              <th scope="col">Room</th>
            </tr>
          </thead>
          <tbody>
            {
              groups.map((group) => (
                <tr>
                  <th scope="row">{group.name}</th>
                  <td>
                    {group.day} {group.start}–{group.end}
                  </td>
                  <td>{group.tutorName}</td>
                  <td>{group.room}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <section aria-labelledby="exceptions-heading">
        <h2 id="exceptions-heading">Exceptions</h2>
        <form method="get" action="/">
          <label for="group-filter">Filter by group</label>
          <select id="group-filter" name="group">
            <option value="">All groups</option>
            {
              groups.map((group) => (
                <option value={group.slug} selected={group.slug === filterSlug}>
                  {group.name}
                </option>
              ))
            }
          </select>
          <button>Filter</button>
        </form>
        {
          filterSlug ? (
            <p>
              Showing only <strong>{groupBySlug.get(filterSlug)?.name ?? filterSlug}</strong>'s
              proposals — <a href="/">show all groups</a>.
            </p>
          ) : null
        }
        <ul id="exceptions" data-groups={JSON.stringify(groups)} aria-live="polite">
          {
            filterSlug && visibleExceptions.length === 0 ? (
              <li class="empty-state">
                {groupBySlug.get(filterSlug)?.name ?? filterSlug} has no exceptions yet.
              </li>
            ) : null
          }
          {
            visibleExceptions.map((exception) => {
              const group = groupBySlug.get(exception.groupSlug);
              // Checked for "proposed" and "confirmed" alike, not just
              // "proposed": two proposals can each get confirmed
              // independently (the whole point of a live, multi-tab board)
              // without either confirmer ever seeing the other's clash
              // warning at the moment they act. Keeping the check alive
              // after confirmation is what makes a real double-booking stay
              // visible instead of disappearing the instant both sides
              // settle.
              const clash =
                exception.status !== "declined"
                  ? findClash(exception, exceptionRows, groupBySlug)
                  : undefined;
              const clashGroup = clash ? groupBySlug.get(clash.groupSlug) : undefined;
              return (
                <li id={`exception-${exception.id}`} data-status={exception.status}>
                  <strong>{group?.name ?? exception.groupSlug}</strong>, week{" "}
                  {exception.week}: moves to {exception.day} {exception.start}–
                  {exception.end}
                  {exception.room ? <> in {exception.room}</> : null} — {exception.reason}
                  {" "}
                  <span class="status">{exception.status}</span>
                  {clash ? (
                    <p class="clash-warning">
                      ⚠ clashes with {clashGroup?.name ?? clash.groupSlug}'s confirmed
                      exception for the same week, day, time and room
                    </p>
                  ) : null}
                  {exception.status === "proposed" ? (
                    <>
                      <form method="post" action={`/api/exceptions/${exception.id}/confirm`}>
                        <button>Confirm</button>
                      </form>
                      <form method="post" action={`/api/exceptions/${exception.id}/decline`}>
                        <button>Decline</button>
                      </form>
                    </>
                  ) : null}
                </li>
              );
            })
          }
        </ul>
      </section>

      <section aria-labelledby="propose-heading">
        <h2 id="propose-heading">Propose an exception</h2>
        <form method="post" action="/api/exceptions">
          <p>
            <label for="groupSlug">Group</label>
            <select id="groupSlug" name="groupSlug" required>
              {groups.map((group) => <option value={group.slug}>{group.name}</option>)}
            </select>
          </p>
          <p>
            <label for="week">Week</label>
            <input id="week" name="week" type="number" min="1" max="12" required />
          </p>
          <p>
            <label for="day">New day</label>
            <input id="day" name="day" required maxlength="10" placeholder="Wed" />
          </p>
          <p>
            <label for="start">New start</label>
            <input id="start" name="start" required maxlength="5" placeholder="14:00" />
          </p>
          <p>
            <label for="end">New end</label>
            <input id="end" name="end" required maxlength="5" placeholder="15:30" />
          </p>
          <p>
            <label for="room">New room (only if different)</label>
            <input id="room" name="room" maxlength="200" />
          </p>
          <p>
            <label for="reason">Reason</label>
            <input id="reason" name="reason" required maxlength="500" />
          </p>
          <button>Propose</button>
        </form>
      </section>
    </main>
    <script>
      // The live half of the board: subscribe to the SSE stream and rebuild
      // the whole list from the whole-list payload it carries (see
      // src/pages/api/events.ts for why one row isn't enough) — reusing the
      // exact same findClash the server rendered with, so a clash warning
      // appears or clears the instant another tab's proposal/confirm/decline
      // changes it, not just on the next reload.
      import { findClash } from "../lib/clashes";
      import type { Exception, Group } from "../lib/schema";

      const list = document.querySelector<HTMLElement>("#exceptions");
      const groups: Group[] = JSON.parse(list?.dataset.groups ?? "[]");
      const groupBySlug = new Map(groups.map((group) => [group.slug, group]));
      // The filter is a plain GET query param — a full navigation applies a
      // new one, so this only has to hold the value steady across live SSE
      // updates on the page already loaded.
      const filterSlug = new URLSearchParams(location.search).get("group") ?? "";

      function renderRow(exception: Exception, all: Exception[]): HTMLLIElement {
        const li = document.createElement("li");
        li.id = `exception-${exception.id}`;
        li.dataset.status = exception.status;

        const strong = document.createElement("strong");
        strong.textContent = groupBySlug.get(exception.groupSlug)?.name ?? exception.groupSlug;
        li.append(strong);

        const roomText = exception.room ? ` in ${exception.room}` : "";
        li.append(
          `, week ${exception.week}: moves to ${exception.day} ${exception.start}–${exception.end}${roomText} — ${exception.reason} `,
        );

        const status = document.createElement("span");
        status.className = "status";
        status.textContent = exception.status;
        li.append(status);

        // Same rule as the server render: check proposed and confirmed rows
        // alike, so a clash between two independently-confirmed exceptions
        // stays visible instead of vanishing once both sides settle.
        if (exception.status !== "declined") {
          const clash = findClash(exception, all, groupBySlug);
          if (clash) {
            const p = document.createElement("p");
            p.className = "clash-warning";
            const clashGroupName = groupBySlug.get(clash.groupSlug)?.name ?? clash.groupSlug;
            p.textContent = `⚠ clashes with ${clashGroupName}'s confirmed exception for the same week, day, time and room`;
            li.append(p);
          }
        }

        if (exception.status === "proposed") {
          for (const [label, action] of [
            ["Confirm", `/api/exceptions/${exception.id}/confirm`],
            ["Decline", `/api/exceptions/${exception.id}/decline`],
          ] as const) {
            const form = document.createElement("form");
            form.method = "post";
            form.action = action;
            const button = document.createElement("button");
            button.textContent = label;
            form.append(button);
            li.append(form);
          }
        }

        return li;
      }

      const source = new EventSource("/api/events");
      source.addEventListener("message", (event) => {
        const all: Exception[] = JSON.parse(event.data);
        const visible = filterSlug ? all.filter((exception) => exception.groupSlug === filterSlug) : all;
        if (filterSlug && visible.length === 0) {
          const li = document.createElement("li");
          li.className = "empty-state";
          li.textContent = `${groupBySlug.get(filterSlug)?.name ?? filterSlug} has no exceptions yet.`;
          list?.replaceChildren(li);
        } else {
          list?.replaceChildren(...visible.map((exception) => renderRow(exception, all)));
        }
      });
    </script>
  </body>
</html>
